<?xml version="1.0" encoding="utf-8"?>

<configuration>
    <!--
    <clear /> removes every package source inherited from user-level and machine-level NuGet configs
    before this repo-local entry is added. This ensures the build never depends on feeds that are
    only available in certain environments (e.g. a corporate Artifact feed), making the solution
    self-contained and reproducible on any machine with internet access.
  -->
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>
</configuration>
