<?xml version="1.0" encoding="utf-8"?>

<!--
    Copyright (c) 2026 LumaCoreTech
    SPDX-License-Identifier: MIT
    Project: https://github.com/LumaCoreTech/OllamaProxy

    Self-contained win-x64 publish profile for the Windows MSI installer.

    Rationale for the settings:
      * SelfContained + RuntimeIdentifier : bundle the .NET runtime so the target machine needs no
                                            prerequisites — the installer "just runs" for non-developers.
      * PublishTrimmed = false            : the options binder resolves configuration through reflection;
                                            trimming risks removing types the binder needs at runtime.
      * PublishSingleFile = false         : a plain folder of binaries is the cleanest input for the WiX
                                            harvest and for a Windows service (the host launches the .exe).
      * PublishReadyToRun = true          : precompile to native code for a faster service cold start.

    Build with:  dotnet publish src/OllamaProxy/OllamaProxy.csproj -c Release -p:PublishProfile=win-x64
-->
<Project>
    <PropertyGroup>
        <Configuration>Release</Configuration>
        <Platform>Any CPU</Platform>
        <PublishProtocol>FileSystem</PublishProtocol>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>false</PublishSingleFile>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishReadyToRun>true</PublishReadyToRun>

        <!--
            Pin a deterministic publish location for the installer to harvest. This path is the default
            the installer's PublishDir property expects (see installer/OllamaProxy.Installer.wixproj), so
            the WiX <Files> harvest and build-installer.ps1 find the payload without extra configuration.

            PublishUrl must mirror PublishDir because two different pipelines consume two different
            properties: 'dotnet publish' writes to PublishDir, but Visual Studio's One-Click (FileSystem
            web publish) copies to PublishUrl. With PublishUrl empty, the SDK's FileSystem target collapses
            its destination to '%(RecursiveDir)%(Filename)%(Extension)' — a path RELATIVE to the project
            directory — dumping the entire publish output into src/OllamaProxy/. Setting both keeps the
            output in /artifacts regardless of how publish is invoked. DeleteExistingFiles clears the target
            on each One-Click publish so stale files from a previous run do not linger.
        -->
        <PublishDir>$(ArtifactsRoot)publish\win-x64\</PublishDir>
        <PublishUrl>$(ArtifactsRoot)publish\win-x64\</PublishUrl>
        <DeleteExistingFiles>true</DeleteExistingFiles>
    </PropertyGroup>
</Project>
