<!-- Project: https://github.com/LumaCoreTech/OllamaProxy -->

<Project Sdk="Microsoft.NET.Sdk.Web">

	<!--
		Project: OllamaProxy
		Purpose: A proxy server for Ollama that provides a REST API for managing models and conversations,
				 and forwards requests to an upstream OpenAI compatible backend.
		Scope: This project contains the main application code for the OllamaProxy server, including controllers,
			   services, and the provider abstraction for interacting with different backends.
	-->

	<!--
	    Common properties (TargetFramework, Nullable, ImplicitUsings, XML docs) are defined centrally in
	    Directory.Build.[props|targets|packages] at the source root to ensure consistency across all projects.
	-->
	<PropertyGroup>
		<RootNamespace>OllamaProxy</RootNamespace>
		<AssemblyName>OllamaProxy</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<!--
		    Expose internal types to the test project so endpoints, mappers, and the
		    provider abstraction can be unit-tested without making them public API.
		-->
		<InternalsVisibleTo Include="OllamaProxy.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" />
	</ItemGroup>

</Project>
