@* Outcome banner rendered at the bottom of the Backends page after a sync attempt. The CSS modifier token
   (applied/rejected/failed) drives the .apply-result-* color rules in the scoped stylesheet so a successful
   apply reads green, a validation rejection amber, and a write failure red. The error list is only rendered
   when the result carries one: most rejections list the field-level reasons the dry-run produced. *@
@if (Outcome.HasValue)
{
	<div class="apply-result apply-result-@ApplyResultBannerPresenter.CssModifier(Outcome.Value)">
		<p class="apply-result-headline">@ApplyResultBannerPresenter.Headline(Outcome.Value)</p>
		@if (Errors is { Count: > 0 })
		{
			<ul class="apply-result-errors">
				@foreach (string error in Errors)
				{
					<li>@error</li>
				}
			</ul>
		}
	</div>
}

@code {

	/// <summary>
	/// The outcome of the most recent apply, or <see langword="null"/> when no apply has been attempted in
	/// this page lifetime. When <see langword="null"/> the banner is omitted entirely; otherwise the CSS
	/// modifier and headline reflect the outcome's class.
	/// </summary>
	[Parameter]
	public ApplyOutcome? Outcome { get; set; }

	/// <summary>
	/// The field-level reasons the change was rejected, or the write-failure message when the apply could not
	/// be persisted. Empty on success.
	/// </summary>
	[Parameter]
	public IReadOnlyList<string>? Errors { get; set; }

}
