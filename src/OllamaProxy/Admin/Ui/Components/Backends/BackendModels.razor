	[Parameter]
	public EventCallback<PinnedContextEdit> OnSetContextOverride { get; set; }

	/// <summary>
	/// The page-supplied setter for one of a pinned model's four capability flags.
	/// </summary>
	[Parameter]
	public EventCallback<PinnedCapabilityEdit> OnSetPinnedCapability { get; set; }

	/// <summary>
	/// Returns <see langword="true"/> when a pinned model's current client-facing name collides with another
	/// entry on this backend, so the row's name input can be flagged inline. The name is trimmed before the
	/// membership test to match <see cref="DuplicateModelNames"/>, whose keys are trimmed; a blank name is never
	/// a duplicate (its own required-name rule reports it instead).
	/// </summary>
	/// <param name="model">The pinned model whose client-facing name is being checked.</param>
	/// <returns>
	/// <see langword="true"/> if <paramref name="model"/>'s trimmed name is one of the backend's
	/// <see cref="DuplicateModelNames"/>; otherwise <see langword="false"/>.
	/// </returns>
	private bool IsDuplicateName(ReconciledModel model)
	{
		string name = GetPinnedName(model);
		return !string.IsNullOrWhiteSpace(name) && DuplicateModelNames.Contains(name.Trim());
	}

	/// <summary>
	/// Maps a reasoning-effort level to its human-readable dropdown label.
	/// </summary>
	private static string ReasoningEffortLabel(ReasoningEffort effort) => effort switch
	{
		ReasoningEffort.None    => "None",
		ReasoningEffort.Minimal => "Minimal",
		ReasoningEffort.Low     => "Low",
		ReasoningEffort.Medium  => "Medium",
		ReasoningEffort.High    => "High",
		ReasoningEffort.XHigh   => "Extra high",
		ReasoningEffort.Max     => "Max",
		var _                   => throw new UnreachableException($"Unhandled reasoning effort '{effort}'.")
	};

	/// <summary>
	/// Gets a short, human-readable description of how a drifted pin diverges from the backend's reported
	/// shape, naming the capability and context differences so the operator can see what the pin still overrides.
	/// </summary>
	private static string DriftSummary(ReconciledModel model)
	{
		List<string> parts = [];

		if (model.HasCapabilityDrift)
		{
			parts.Add($"capabilities are pinned as {CapabilitySummary(model.Capabilities)}, but the backend reports {CapabilitySummary(model.DiscoveredCapabilities)}");
		}

		if (model.HasContextDrift)
		{
			parts.Add($"context is pinned as {ContextSummary(model.ContextLength)}, but the backend reports {ContextSummary(model.DiscoveredContextLength)}");
		}

		return parts.Count > 0
			       ? $"Pinned settings differ from the backend: {string.Join("; ", parts)}."
			       : "Pinned settings differ from what the backend reports.";
	}

	/// <summary>
	/// Gets a compact, comma-separated list of the capabilities a model supports, or a placeholder when none
	/// are known or none are enabled.
	/// </summary>
	private static string CapabilitySummary(ModelCapabilities? capabilities)
	{
		if (capabilities is null) return "—";

		List<string> flags = [];
		if (capabilities.SupportsCompletion) flags.Add("completion");
		if (capabilities.SupportsTools) flags.Add("tools");
		if (capabilities.SupportsVision) flags.Add("vision");
		if (capabilities.SupportsEmbeddings) flags.Add("embeddings");

		return flags.Count > 0 ? string.Join(", ", flags) : "none";
	}

	/// <summary>
	/// Gets a stable identifier for a model's detail panel so the toggle button can reference it with
	/// <c>aria-controls</c>. The row index is unique within this rendered table and the component id prevents
	/// collisions with other backend tables.
	/// </summary>
	/// <param name="rowIndex">The model row index in the current reconciliation table.</param>
	/// <returns>A detail panel id unique to the model within this backend.</returns>
	private string GetModelDetailPanelId(int rowIndex) => $"backend-model-detail-{mComponentId}-{rowIndex.ToString(CultureInfo.InvariantCulture)}";

	/// <summary>
	/// Gets a human-readable context-window value, formatting the token count with thousands separators or a
	/// placeholder when none could be resolved.
	/// </summary>
	private static string ContextSummary(long? contextLength) => contextLength is { } tokens
		                                                             ? tokens.ToString("N0", CultureInfo.InvariantCulture)
		                                                             : "—";

	/// <summary>
	/// Formats a model's normalized per-million-token pricing for display, emitting an input/output pair when
	/// both are known, a single labeled figure when only one is, or an empty string when the backend reported
	/// no price.
	/// </summary>
	private static string PriceSummary(ProviderModelMetadata metadata)
	{
		string? input = FormatUsd(metadata.PromptUsdPerMillionTokens);
		string? output = FormatUsd(metadata.CompletionUsdPerMillionTokens);

		return (input, output) switch
		{
			({ } i, { } o) => $"in {i} · out {o}",
			({ } i, null)  => $"in {i}",
			(null, { } o)  => $"out {o}",
			var _          => string.Empty
		};
	}

	/// <summary>
	/// Formats a USD amount with enough precision for the small per-token fractions, or <see langword="null"/>
	/// when the amount is absent.
	/// </summary>
	private static string? FormatUsd(decimal? amount) => amount is { } value
		                                                     ? "$" + value.ToString(value < 1m ? "0.####" : "0.00", CultureInfo.InvariantCulture)
		                                                     : null;

}
