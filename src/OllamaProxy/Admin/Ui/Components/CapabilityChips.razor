@* Authored as markup (not via RenderTreeBuilder) so Blazor CSS isolation stamps the scope attribute onto each
   element and the scoped chip styles actually apply. The previous builder-based rendering received no scope
   attribute, so the flex gap and pill backgrounds were silently dropped and the chips ran together. *@
@if (mChips.Count == 0)
{
	@* No capability is supported or unconfirmed (e.g. an embedding-only model whose only flag was conclusively
	   negative): a muted placeholder instead of an empty cell. *@
	<span class="caps-none">none</span>
}
else
{
	<div class="caps-chips">
		@foreach (CapabilityChip chip in mChips)
		{
			<span class="@chip.CssClass" title="@chip.Title">@chip.Text</span>
		}
	</div>
}

@code {

	/// <summary>
	/// The resolved capabilities to render as chips. A confirmed capability is a solid chip; completion whose
	/// probe stayed inconclusive is a supported-but-unconfirmed chip (kept exposed/fail-open, carrying a "?"); an
	/// optional capability (tools, vision, embeddings) whose probe stayed inconclusive is an off-but-unconfirmed
	/// "?" chip. A capability that was conclusively probed as unsupported produces no chip, so the cell shows what
	/// is known rather than a list of negatives. The unconfirmed chips are what stop a failed probe from reading
	/// as a measured fact.
	/// </summary>
	[Parameter]
	[EditorRequired]
	public required ModelCapabilities Capabilities { get; init; }

	/// <summary>
	/// The chips computed from <see cref="Capabilities"/> for the current render, rebuilt on each parameter set.
	/// </summary>
	private IReadOnlyList<CapabilityChip> mChips = [];

	/// <inheritdoc/>
	protected override void OnParametersSet() => mChips = CapabilityChipBuilder.BuildChips(Capabilities);

}
