<Project Sdk="Microsoft.NET.Sdk">

	<!-- 
		Project: OllamaProxy.Tests
		Purpose: Unit tests for the OllamaProxy project, covering controllers, mappers, and the provider abstraction.
		Scope: This project contains test classes and methods that validate the functionality of the main application
		       code in OllamaProxy. It references the main project to access internal types and ensures that all
		       components work as expected.
	-->
	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<!-- Test projects intentionally do not require XML documentation. -->
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="bunit" />
		<PackageReference Include="coverlet.collector">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="coverlet.msbuild" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="xunit" />
		<PackageReference Include="xunit.runner.visualstudio">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<!--
			bUnit renders the Admin Blazor components in-process (no browser). Rendering Razor components pulls in
			the ASP.NET Core component types, which are part of the shared framework and are not flowed transitively
			through the ProjectReference to the Web-SDK main project, so the test project references the framework
			directly.
		-->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\OllamaProxy\OllamaProxy.csproj" />
	</ItemGroup>

</Project>
